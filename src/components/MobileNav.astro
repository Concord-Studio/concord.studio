---
import { getNavbarLinks } from "../lib/theme-navbar";
import MobileNavLink from "./MobileNavLink.astro";
import MobileNavSublist from "./MobileNavSublist.astro";

const { sidebar } = Astro.locals.starlightRoute;
const navLinks = await getNavbarLinks(Astro.currentLocale);
---

<div class="mobile-nav">
  <div class="mobile-nav-content">
    {
      navLinks.length > 0 && (
        <div class="mobile-nav-section">
          <div class="mobile-nav-label">
            {Astro.locals.t("menuButton.accessibleLabel")}
          </div>
          <div class="mobile-nav-links">
            {navLinks.map((nav) => (
              <MobileNavLink
                href={nav.link}
                label={nav.label}
                attrs={nav.attrs}
              />
            ))}
          </div>
        </div>
      )
    }

    <MobileNavSublist entries={sidebar} />
  </div>
</div>

<style>
  :global([data-mobile-menu-expanded]) {
    --black-menu-visibility: visible;
  }

  .mobile-nav {
    visibility: var(--black-menu-visibility, hidden);
    display: flex;
    position: fixed;
    top: var(--sl-nav-height);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: calc(var(--sl-z-index-navbar) + 2);
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(8px);
    flex-direction: column;
    justify-content: flex-start;
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    padding: 1.5rem;
    height: 100%;
  }

  .mobile-nav-content::-webkit-scrollbar {
    width: 0;
  }

  .mobile-nav-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-label {
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

</style>
